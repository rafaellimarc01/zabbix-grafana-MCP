# =============================================================================
# Zabbix + Grafana - variáveis de ambiente (Docker Compose)
#
# NÃO copie este arquivo na mão. Gere o .env com senhas aleatórias e fortes:
#   make env            (ou: ./scripts/generate-secrets.sh)
# As senhas ficam vazias aqui de propósito: o Docker Compose se recusa a subir
# se alguma delas não estiver definida no .env.
# O arquivo .env está no .gitignore e nunca deve ser enviado ao GitHub.
# =============================================================================

# ---- Versões das imagens ----------------------------------------------------
# Zabbix 7.0 é LTS (suporte até 2029). Para testar a 8.0 LTS use "alpine-8.0-latest".
ZABBIX_VERSION=alpine-7.0.32
GRAFANA_VERSION=12.4.16
POSTGRES_VERSION=16-alpine

# ---- Fuso horário ----------------------------------------------------------
TZ=America/Sao_Paulo

# ---- Banco de dados (PostgreSQL) -------------------------------------------
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=

# ---- Backup automático do banco --------------------------------------------
# O serviço postgres-backup faz um pg_dump todo dia neste horário (fuso TZ)
# e apaga os backups com mais de BACKUP_KEEP_DAYS dias.
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=7

# ---- Zabbix ----------------------------------------------------------------
# Senha que o usuário "Admin" do Zabbix vai receber no primeiro start
# (o serviço zabbix-init troca a senha padrão "zabbix" por esta).
# Mínimo de 8 caracteres e não pode conter "Admin" nem "Zabbix".
ZABBIX_ADMIN_PASSWORD=
# Senha do usuário "grafana" do Zabbix, só leitura e só API, usado pelo
# Grafana para ler os dados (o Grafana não usa o Admin).
ZABBIX_GRAFANA_PASSWORD=

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---- Alertas do Grafana (opcional) ----------------------------------------
# As regras de alerta já vêm prontas e aparecem na tela do Grafana.
# Para receber notificações, preencha um dos blocos abaixo e ative o exemplo
# correspondente em grafana/alerting-examples/ (veja "Alertas" no README).
# Endereço com que você abre o Grafana; vai nos links das notificações.
GRAFANA_ROOT_URL=http://localhost:3000/
# E-mail: servidor SMTP (ex.: smtp.gmail.com:587) e destinatários (separe com ;).
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
# Senha do SMTP (o nome não termina em _PASSWORD de propósito, para o
# make env não gerar uma senha aleatória aqui).
GRAFANA_SMTP_PASS=
GRAFANA_SMTP_FROM=
ALERT_EMAIL_TO=
# Telegram: token do bot (@BotFather). O id do chat vai no arquivo do exemplo.
TELEGRAM_BOT_TOKEN=

# ---- Rede / portas expostas no host ----------------------------------------
# Por padrão o Zabbix web e o Grafana só aceitam conexões do próprio
# computador (127.0.0.1), porque falam HTTP sem criptografia.
# Para acessar de outra máquina, use um proxy reverso com HTTPS ou troque
# para 0.0.0.0 sabendo que o tráfego (e as senhas) passa sem TLS.
BIND_ADDRESS=127.0.0.1
ZABBIX_WEB_PORT=8080
GRAFANA_PORT=3000
# O trapper (10051) recebe dados dos agentes ativos, por isso escuta em todas
# as interfaces. Atenção: o Docker passa por cima do UFW/firewalld, então um
# "ufw deny" não protege esta porta. Use o IP da rede dos agentes aqui ou
# filtre na chain DOCKER-USER (veja "Protegendo a porta 10051" no README).
ZABBIX_SERVER_BIND_ADDRESS=0.0.0.0
ZABBIX_SERVER_PORT=10051
