# NÃO copie na mão. Gere o secrets.env (está no .gitignore) com senhas
# aleatórias:  make k8s-secrets   (ou: ./scripts/generate-secrets.sh k8s)
# Se preencher à mão: mínimo de 12 caracteres, e a senha do Admin do Zabbix
# não pode conter "Admin" nem "Zabbix".
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=
ZABBIX_ADMIN_PASSWORD=
ZABBIX_GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
