# NÃO copie na mão. Gere o secrets.env (está no .gitignore) com senhas
# aleatórias:  make k8s-secrets   (ou: ./scripts/generate-secrets.sh k8s)
# Se preencher à mão: mínimo de 12 caracteres, e a senha do Admin do Zabbix
# não pode conter "Admin" nem "Zabbix".
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=
ZABBIX_ADMIN_PASSWORD=
ZABBIX_GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Token que as IAs usam no MCP (componente kubernetes/components/mcp).
MCP_PASSWORD=

# Notificações dos alertas do Grafana (opcional; veja "Alertas" no README).
# GRAFANA_ROOT_URL=https://grafana.exemplo.com/
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASS=
# GRAFANA_SMTP_FROM=grafana@exemplo.com
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
