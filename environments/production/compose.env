# Configurações do ambiente de PRODUÇÃO (Docker Compose). Sem senhas.
# "make env DEPLOY_ENV=production" gera o .env a partir do .env.example com
# estes valores no lugar dos do exemplo e senhas próprias deste ambiente.
DEPLOY_ENV=production
# Arquivos que o Docker Compose usa: o padrão + os ajustes de produção.
COMPOSE_FILE=docker-compose.yml:environments/production/compose.yml
COMPOSE_PATH_SEPARATOR=:
# Mesmo nome do ambiente padrão: quem já usa o modelo passa para produção
# mantendo os volumes (os dados).
COMPOSE_PROJECT_NAME=zabbix-grafana
# Endereço público do Grafana (vai nos links das notificações). Troque pelo
# domínio do proxy reverso com HTTPS que fica na frente (veja o README).
GRAFANA_ROOT_URL=https://grafana.example.com/
# Produção guarda um mês de backups. Copie-os também para fora do servidor.
BACKUP_KEEP_DAYS=30
