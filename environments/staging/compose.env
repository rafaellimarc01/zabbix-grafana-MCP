# Configurações do ambiente de STAGING (Docker Compose). Sem senhas.
# "make env DEPLOY_ENV=staging" gera o .env a partir do .env.example com estes
# valores no lugar dos do exemplo e senhas próprias deste ambiente.
DEPLOY_ENV=staging
# Arquivos que o Docker Compose usa: o padrão + os ajustes de staging.
COMPOSE_FILE=docker-compose.yml:environments/staging/compose.yml
COMPOSE_PATH_SEPARATOR=:
# Nome próprio: containers, redes e volumes ficam separados dos de produção,
# mesmo se os dois rodarem na mesma máquina (em pastas diferentes).
COMPOSE_PROJECT_NAME=zabbix-grafana-staging
# Portas diferentes das de produção, para os dois caberem na mesma máquina.
ZABBIX_WEB_PORT=8081
GRAFANA_PORT=3001
ZABBIX_SERVER_PORT=10052
MCP_PORT=8766
GRAFANA_ROOT_URL=http://localhost:3001/
# Staging guarda menos backups.
BACKUP_KEEP_DAYS=3
